# --- OpenAI Secure MCP Tunnel ---------------------------------------------
# Tunnel id: https://platform.openai.com/settings/organization/tunnels
CONTROL_PLANE_TUNNEL_ID=tunnel_0123456789abcdef0123456789abcdef
# Runtime API key (NOT an admin key):
# https://platform.openai.com/settings/organization/api-keys
# Needs Tunnels: Read + Use
CONTROL_PLANE_API_KEY=sk-...

# Pin the client image (see https://github.com/openai/tunnel-client/releases)
TUNNEL_CLIENT_VERSION=v0.0.12

# --- Local ports (host loopback only) --------------------------------------
MCP_HOST_PORT=8090
TUNNEL_HEALTH_PORT=8091

# --- Ownership of ./workspace files written by the MCP server ---------------
PUID=1001
PGID=1001

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=struct-text
