# ── OpenAI Secure MCP Tunnel ────────────────────────────────────────────────
# tunnel id: https://platform.openai.com/settings/organization/tunnels
CONTROL_PLANE_TUNNEL_ID=tunnel_0123456789abcdef0123456789abcdef
# runtime API key (ไม่ใช่ admin key) สิทธิ์ Tunnels: Read + Use
# https://platform.openai.com/settings/organization/api-keys
CONTROL_PLANE_API_KEY=sk-...
# pin version: https://github.com/openai/tunnel-client/releases
TUNNEL_CLIENT_VERSION=v0.0.12

# ── ความปลอดภัยของ MCP server ───────────────────────────────────────────────
# ว่าง = ไม่มี auth (ใช้ได้เฉพาะตอน bind 127.0.0.1 เท่านั้น)
# ตั้งค่า = ทุก request ต้องมี `Authorization: Bearer <ค่านี้>` ยกเว้น /healthz
# สร้าง token: openssl rand -hex 32
# tunnel-client จะแนบ header ให้เองอัตโนมัติเมื่อค่านี้ไม่ว่าง
MCP_AUTH_TOKEN=

# ── พอร์ตฝั่ง host ──────────────────────────────────────────────────────────
# 127.0.0.1 = เข้าได้จากเครื่องนี้เท่านั้น; 0.0.0.0 = เปิดให้ทั้ง LAN (ต้องตั้ง MCP_AUTH_TOKEN ก่อน)
MCP_BIND_ADDR=127.0.0.1
MCP_HOST_PORT=8090
TUNNEL_HEALTH_PORT=8091

# ── Cloudflare Tunnel (ทางเลือก เทียบกับท่อของ OpenAI) ──────────────────────
CLOUDFLARED_VERSION=latest
# ใช้เฉพาะ profile cf-named: token จาก Cloudflare Zero Trust dashboard
CLOUDFLARE_TUNNEL_TOKEN=

# ── เจ้าของไฟล์ที่เขียนลง ./workspace ───────────────────────────────────────
PUID=1001
PGID=1001

# ── log ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=struct-text
